      "font": "Open Sans",
      "background": {
        "type": "Color",
        "content": "#EFEAE2"
      }
    },
    "chat": {
      "hostAvatar": {
        "isEnabled": true,
        "url": "expert-avatar.jpg"
      },
      "guestAvatar": {
        "isEnabled": false
      },
      "hostBubbles": {
