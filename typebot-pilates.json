            ]
          }
        },
        {
          "id": "block_text_78_rnddd67",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "📸 [Depoimento Leopoldina (Antes e Depois): Perdeu 15kg em 5 semanas com foto visível de evolução]"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_79_nufops7",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Você está preparada para essa transformação na sua vida?"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_choice_80_4v3vtls",
          "type": "choice input",
          "items": [
            {
              "id": "item_16_0_81_f93tmhw",
