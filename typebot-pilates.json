                    "text": "✅ Melhora da flexibilidade"
                  }
                ]
              },
              {
                "type": "p",
                "children": [
                  {
                    "text": "✅ Pode ser feito em casa"
                  }
                ]
              },
              {
                "type": "p",
                "children": [
                  {
                    "text": "✅ Sem aparelhos, você não precisa comprar NADA."
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_76_z77pwwz",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Dá uma olhada no que algumas das minhas alunas que começaram do zero me mandaram essa semana 👇"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_77_02qxss7",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "📸 [Depoimento Neuza: Perdeu o medo de usar o app e sentiu alívio das dores articulares em 1 semana]"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_78_n1k0nl5",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "📸 [Depoimento Leopoldina (Antes e Depois): Perdeu 15kg em 5 semanas com foto visível de evolução]"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_79_o42ohu4",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Você está preparada para essa transformação na sua vida?"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_choice_80_zdnjbqe",
          "type": "choice input",
          "items": [
            {
              "id": "item_16_0_81_ct2wdti",
              "content": "SIM, EU ACEITO O DESAFIO!",
              "outgoingEdgeId": "edge_16_item_0_to_17"
            }
          ],
