          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Dá uma olhada no que algumas das minhas alunas que começaram do zero me mandaram essa semana 👇"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_77_jjmfe5w",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "📸 [Depoimento Neuza: Perdeu o medo de usar o app e sentiu alívio das dores articulares em 1 semana]"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_78_2yse31t",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "📸 [Depoimento Maria Silva: Perdeu 3,5kg em 4 semanas sem deixar de comer o que gosta]"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_79_qulv55n",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "📸 [Depoimento Leopoldina (Antes e Depois): Perdeu 15kg em 5 semanas com foto visível de evolução]"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_text_80_5fv5eu8",
          "type": "text",
          "content": {
            "richText": [
              {
                "type": "p",
                "children": [
                  {
                    "text": "Você está preparada para essa transformação na sua vida?"
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "block_choice_81_x3kpg62",
          "type": "choice input",
          "items": [
            {
              "id": "item_16_0_82_d33pjd3",
              "content": "SIM, EU ACEITO O DESAFIO!",
